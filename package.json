{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "keygen": "node scripts/keygen.mjs",
    "test:schema": "node scripts/test-schema.mjs",
    "test:ticket": "node --env-file=.env.local scripts/test-ticket.mjs",
    "test:gate": "node --env-file=.env.local scripts/test-gate.mjs",
    "email:preview": "open http://localhost:3000/api/email/preview",
    "email:shot": "node scripts/email-shot.mjs",
    "demo:tickets": "node --env-file=.env.local scripts/make-demo-tickets.mjs",
    "demo:build": "NEXT_PUBLIC_SCANNER_DEMO=1 next build",
    "demo:serve": "NEXT_PUBLIC_SCANNER_DEMO=1 next start -p 3002",
    "demo:phone": "node scripts/phone-preview.mjs",
    "test:demo": "node scripts/test-demo.mjs",
    "demo:stop": "bash -c 'for p in ${PORT:-3002} $((${PORT:-3002}+1)); do lsof -ti:$p | xargs kill 2>/dev/null; done; echo \"phone preview stopped\"'",
    "test:aim": "node scripts/test-aim.mjs",
    "test:paths": "node scripts/test-scanner-paths.mjs"
  },
  "dependencies": {
    "@noble/ed25519": "^3.2.0",
    "@noble/hashes": "^2.4.0",
    "@supabase/supabase-js": "^2.118.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "lenis": "^1.3.27",
    "motion": "^14.7.0",
    "next": "16.4.3",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@tailwindcss/turbopack": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "playwright": "^1.64.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
